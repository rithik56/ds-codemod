{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "lib": [
      "es2018"
    ],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "checkJs": false,
    "types": [
      "node",
      "jscodeshift"
    ]
  },
"include": [
  "src/**/*.ts"
],
"exclude": [
  "**/*.test.{js,ts}",
  "src/**/actual*.{js,ts}",
  "testUtils/**/*",
  "src/v7.0.0/**/*.test.ts",
  "src/v8.0.0/**/*.test.ts"
]
}